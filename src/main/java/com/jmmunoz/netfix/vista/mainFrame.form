            <Component class="javax.swing.JButton" name="salir">
              <Properties>
                <Property name="icon" type="javax.swing.Icon" editor="org.netbeans.modules.form.editors2.IconEditor">
                  <Image iconType="3" name="/img/logout.png"/>
                </Property>
